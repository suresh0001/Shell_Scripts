#!/bin/bash
uid=$(id -u)
if [ $uid -ne 0 ]; then
    echo "Please run the script with sudo user:"
    exit 1
fi

dnf install nginx -y
if [ $? -ne 0 ]; then

    echo "Nginx installation is failed"
else
    echo "Nginx installation is success"
fi

dnf install mysql -y
if [ $? -ne 0 ]; then
    echo "mysql installation is failed"
else
    echo "mysql intallation is success"
fi